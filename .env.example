APP_ENV=production
SERVICE_NAME=internal-portal-administration-backend
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/devante_app?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-different-32-character-secret
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
AUTH_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=replace-with-your-tenant-id
ALLOWED_EMAIL_DOMAINS=
MAX_UPLOAD_BYTES=26214400
# Local/Docker: paddle (install requirements-local.txt); serverless: rapid.
OCR_ENGINE=paddle
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
LOCAL_UPLOAD_DIRECTORY=uploads
